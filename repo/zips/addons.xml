<?xml version='1.0' encoding='utf-8'?>
<addons><addon id="repository.xodi.org" name="Xodi Add-on repository" version="3.4.0" provider-name="Team Xodi">
  <requires>
    <import addon="xbmc.addon" version="12.0.0" />
  </requires>
    <extension point="xbmc.addon.repository">
        
        <dir>
            <info compressed="false">https://raw.githubusercontent.com/xbmc4xbox/repository.xodi.org/master/repo/zips/addons.xml</info>
            <checksum>https://raw.githubusercontent.com/xbmc4xbox/repository.xodi.org/master/repo/zips/addons.xml.md5</checksum>
            <datadir zip="true">https://raw.githubusercontent.com/xbmc4xbox/repository.xodi.org/master/repo/zips/</datadir>
        </dir>
        <dir minversion="5.0.0">
            <info compressed="false">https://raw.githubusercontent.com/xbmc4xbox/repository.xodi.org/master/omega/zips/addons.xml</info>
            <checksum>https://raw.githubusercontent.com/xbmc4xbox/repository.xodi.org/master/omega/zips/addons.xml.md5</checksum>
            <datadir zip="true">https://raw.githubusercontent.com/xbmc4xbox/repository.xodi.org/master/omega/zips/</datadir>
        </dir>
    </extension>
    <extension point="xbmc.addon.metadata">
        <platform>all</platform>
        <assets>
            <icon>icon.png</icon>
        </assets>
        <summary lang="en_GB">Install Add-ons from Xodi.tv</summary>
        <description lang="en_GB">Download and install add-ons from the Official Xodi.tv add-on repository.</description>
        <disclaimer lang="en_GB">Team Xodi did not make all the add-ons on this repository and are not responsible for their content</disclaimer>
    </extension>
</addon><addon id="screensaver.flubberidoo" version="1.0.0" name="Flubberidoo" provider-name="Team Resurgent">
  <requires>
    <import addon="kodi.binary.global.main" minversion="2.0.0" version="2.0.2" />
    <import addon="kodi.binary.global.filesystem" minversion="1.1.7" version="1.1.9" />
    <import addon="kodi.binary.instance.screensaver" minversion="2.2.0" version="2.2.0" />
  </requires>
  <extension point="xbmc.ui.screensaver" library_xbox="Flubberidoo.xbs" />
  <extension point="xbmc.addon.metadata">
    <platform>xbox</platform>
    <license>GPL-2.0-or-later</license>
    <source>https://github.com/Team-Resurgent/screensaver.flubberidoo</source>
    <assets>
      <icon>resources/icon.png</icon>
      <fanart>resources/fanart.jpg</fanart>
      <screenshot>resources/screenshot-01.jpg</screenshot>
      <screenshot>resources/screenshot-02.jpg</screenshot>
    </assets>
    <summary lang="en_GB">Flubberidoo boot-animation screensaver</summary>
    <description lang="en_GB">A faithful D3D8 re-creation of the classic Xbox boot animation: the gooey "flubber" blob pulsing at the heart of a slowly rotating scene while the camera drifts around it, wrapped in shimmering shields. Loops endlessly (no end logo, no sound). Fully themeable from the addon settings.</description>
  </extension>
</addon><addon id="visualization.milkdrop" version="2.0.0" name="MilkDrop" provider-name="Team XBMC">
  <extension point="xbmc.player.musicviz" library_xbox="MilkDrop.vis" />
  <extension point="xbmc.addon.metadata">
    <summary lang="en_GB">MilkDrop takes you flying through the soundwaves you're hearing</summary>
    <description lang="en_GB">MilkDrop was originally a music visualiser "plug-in" to the Winamp music player. As you listen to your music, MilkDrop takes you flying through the actual soundwaves you're hearing, and uses beat detection to trigger myriad psychedelic effects, creating a rich visual journey through sound.</description>
    <platform>xbox</platform>
    <license>GPL-2.0</license>
    <source>https://github.com/xbmc4xbox/visualization.milkdrop</source>
    <assets>
      <icon>resources/icon.png</icon>
      <fanart>resources/fanart.jpg</fanart>
      <screenshot>resources/screenshot-01.jpg</screenshot>
      <screenshot>resources/screenshot-02.jpg</screenshot>
      <screenshot>resources/screenshot-03.jpg</screenshot>
      <screenshot>resources/screenshot-04.jpg</screenshot>
      <screenshot>resources/screenshot-05.jpg</screenshot>
      <screenshot>resources/screenshot-06.jpg</screenshot>
    </assets>
  </extension>
</addon></addons>